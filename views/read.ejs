<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Document</title>

    <link rel="stylesheet" href="/stylesheets/style.css">

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">

        <h1 class="text-3xl tracking-tighter mb-3 ml-10">
            All Users
        </h1>
        
        <div class="users flex gap-5 p-10 flex-wrap">
            <% if(users.length > 0){ %>
                
            <% users.forEach(function(user) { %>

                <div class="user w-60 h-96 p-3 bg-zinc-800 rounded-lg">

                    <div class="w-full h-60 rounded-lg bg-zinc-500 overflow-hidden">

                        <img
                            class="w-full h-60 object-cover object-top"
                            src="<%= user.img %>"
                            alt="User Image"
                        >

                    </div>

                    <h3 class="text-xl mt-3 tracking-tighter">
                        <%= user.userName %>
                    </h3>

                    <h5 class="text-zinc-500">
                        <%= user.email %>
                    </h5>

                    <div class="flex gap-4 mt-10">

                        <a
                            class="text-zinc-200"
                            href="/edit/<%= user._id %>"
                        >
                            Edit User
                        </a>

                        <a
                            class="text-red-600"
                            href="/delete/<%= user.email %>"
                        >
                            Delete User
                        </a>

                    </div>

                </div>

            <% }) %>
            <% } else { %>
                <h1 class="text-white">No Users Yet</h1>
            <% } %>
        </div>

        <a
            href="/"
            class="inline-block p-2 rounded-md bg-blue-500 text-white mt-7 ml-10"
        >
            Back to Home
        </a>

    </div>

</body>

</html>